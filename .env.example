# Create via Telegram @BotFather; keep secret.
TELEGRAM_BOT_TOKEN=put_your_botfather_token_here
# Create at https://aistudio.google.com/apikey ; keep secret.
GEMINI_API_KEY=put_your_gemini_api_key_here
# On first launch, send /chatid in your Telegram group. Paste its negative ID here, restart.
ALLOWED_CHAT_ID=
# Stable multimodal model (text, photos, audio); change if needed.
GEMINI_MODEL=gemini-3.5-flash-lite
TIMEZONE=Europe/Copenhagen
# For Railway, attach a persistent volume mounted at /data.
DB_PATH=./data/food.sqlite3
# Preconfigured: AKVE calorie count master — exact existing spreadsheet, not a secret.
# Bot still needs service-account JSON with Editor access to this sheet.
GOOGLE_SHEET_ID=1w6s6N5IpNHtuYUHBT6QO3PJ2ZDsLVysq4iHIQXLZg1A
# Optional: free USDA FoodData Central API key for online ingredient reference.\n# If omitted, DEMO_KEY works for initial testing but has very low limits.\nFDC_API_KEY=\n# On Railway, paste raw service account JSON as one private variable (never into GitHub).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON when running locally:
GOOGLE_SERVICE_ACCOUNT_FILE=
# Ingredient references are read from База продуктов, База ингредиентов and Ingredients base.
# Nightly output goes ONLY to the separate Bot Daily Totals tab.
GOOGLE_DAILY_TAB=Bot Daily Totals
